# Tachyon dev server config for the SESAME website.
YON_PORT=8081

# Pages use inline <style> blocks (for example /docs hides the home shell).
YON_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:

# Browser-visible env (Tachyon `this.env()` allowlist)
TAC_PUBLIC_ENV=PUBLIC_SITE_URL
PUBLIC_SITE_URL=https://sesame.del.ma
