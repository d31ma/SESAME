# Copy to .env next to package.json. Tachyon reads only YON_ names from it,
# and `ty serve` refuses any other name. Paths are not secrets: a
# server/application-<profile>.json file selected with YON_PROFILE works too.
# Absolute path of the sesame executable built from this repository.
# YON_SESAME_BINARY=/absolute/path/to/sesame
# Absolute path of the deployment directory created by `sesame init`.
# YON_SESAME_DEPLOYMENT=/absolute/path/to/deployment
