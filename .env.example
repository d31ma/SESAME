# SESAME reads this file only when it is explicitly passed to `sesame init`:
#
#   cp .env.example .env
#   sesame init --env-file .env
#
# The FYLO executable must be an absolute path. Generated signing, sealing,
# and snapshot keys never belong in this file; `sesame init` creates them in
# the deployment's private key directory.
SESAME_DEPLOYMENT=./deploy
FYLO_BINARY=/absolute/path/to/fylo
SESAME_ISSUER=https://id.example.com
